<project>
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>es.uclm.esi.iso2</groupId>
    <artifactId>radiodiagnostico</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>cliente</artifactId>
  <version>1.1.0-SNAPSHOT</version>
  <name>Cliente de consola</name>

  <dependencies>
    <!-- Solo se usan las interfaces del paquete api del servidor (D-007) -->
    <dependency>
      <groupId>es.uclm.esi.iso2</groupId>
      <artifactId>servidor</artifactId>
      <version>1.5.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Jar ejecutable con el servidor dentro: java -jar cliente/target/cliente-x.y.z.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>es.uclm.esi.iso2.cliente.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
