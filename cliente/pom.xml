<project>
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>es.uclm.esi.iso2</groupId>
    <artifactId>radiodiagnostico</artifactId>
    <version>1.0.1</version>
  </parent>
  <artifactId>cliente</artifactId>
  <version>2.0.1</version>
  <name>Cliente (JavaFX y consola)</name>

  <properties>
    <javafx.version>17.0.12</javafx.version>
  </properties>

  <dependencies>
    <!-- Solo se usan las interfaces del paquete api del servidor (D-007) -->
    <dependency>
      <groupId>es.uclm.esi.iso2</groupId>
      <artifactId>servidor</artifactId>
      <version>1.12.1</version>
    </dependency>
    <!-- Vista gráfica (D-017): solo en el cliente -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- La vista JavaFX necesita pantalla: se prueba a mano (Plan de pruebas). Los controladores sí se prueban -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>es/uclm/esi/iso2/cliente/vista/fx/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <!-- mvn -pl cliente javafx:run -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>es.uclm.esi.iso2.cliente.Main</mainClass>
        </configuration>
      </plugin>
      <!-- Jar ejecutable con el servidor dentro: java -jar cliente/target/cliente-x.y.z.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>es.uclm.esi.iso2.cliente.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- El informe de cobertura del sitio excluye lo mismo que la comprobación del build (vista JavaFX) -->
  <reporting>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>es/uclm/esi/iso2/cliente/vista/fx/**</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </reporting>
</project>
